  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test-email": "node test-email.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeders/seeder.js",
    "seed:fresh": "node seeders/seed.js --no-clear",
    "seed:books": "node -e \"require('./seeders/bookSeeder').seedBooksWithStrategy('balanced', 50).then(() => process.exit(0)).catch(e => {console.error(e); process.exit(1);})\"",
    "seed:users": "node -e \"require('./seeders/userSeeder').seedUsersWithStrategy('realistic', 10).then(() => process.exit(0)).catch(e => {console.error(e); process.exit(1);})\"",
    "seed:books:fantasy": "node -e \"require('./seeders/bookSeeder').seedBooksWithStrategy('fantasy', 30).then(() => process.exit(0)).catch(e => {console.error(e); process.exit(1);})\"",
    "seed:books:classics": "node -e \"require('./seeders/bookSeeder').seedBooksWithStrategy('classics', 20).then(() => process.exit(0)).catch(e => {console.error(e); process.exit(1);})\"",
    "seed:cli": "node seeders/cli.js",
    "seed:test": "node test-seeder.js",
    "seed:verify": "node verify-seeder.js",
    "seed:help": "node seeders/seed.js --help"
  },
